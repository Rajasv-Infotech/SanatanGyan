@inherits LayoutComponentBase
@implements IDisposable
@inject LanguageService Loc

<div class="app-shell">
    <header class="topbar">
        <div class="topbar-inner">
            <a class="brand sanatan-wordmark" href="/" aria-label="Sanatan Gyan">
                <span class="brand-mark om-mark" aria-hidden="true">ॐ</span>
                <span class="brand-copy">
                    <strong>SANATAN GYAN</strong>
                    <span class="brand-hi">सनातन ज्ञान</span>
                    <small>@Loc.T("brand_subtitle")</small>
                </span>
            </a>

            <nav class="desktop-nav" aria-label="Desktop navigation">
                <NavLink href="/today">☀ @Loc.T("today_sanatan")</NavLink>
                <NavLink href="/understand">ॐ @Loc.T("understand_sanatan")</NavLink>
                <NavLink href="/texts">📜 @Loc.T("texts_library_short")</NavLink>
                <NavLink href="/timeline">⌛ @Loc.T("history")</NavLink>
                <NavLink href="/epic-evidence">🏺 @Loc.T("evidence_short")</NavLink>
            </nav>

            <div class="language-switch" title="@Loc.T("language")">
                <button class="lang-btn @(Loc.Current == "en" ? "active" : "")" @onclick='() => ChangeLanguage("en")'>EN</button>
                <button class="lang-btn @(Loc.Current == "hi" ? "active" : "")" @onclick='() => ChangeLanguage("hi")'>हिंदी</button>
            </div>
        </div>
    </header>

    <main class="content-wrap">
        <div @key="Loc.Current">@Body</div>
    </main>

    <nav class="bottom-nav" aria-label="Primary navigation">
        <NavLink href="/" Match="NavLinkMatch.All">
            <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 10.5 12 3.7l8.5 6.8v9.2a1.3 1.3 0 0 1-1.3 1.3h-4.7v-6.1h-5V21H4.8a1.3 1.3 0 0 1-1.3-1.3z"/><path d="M8.4 21v-7h7.2v7"/></svg>
            <small>@Loc.T("home")</small>
        </NavLink>
        <NavLink href="/learn">
            <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 5.2c2.8-.8 5.4-.4 8.5 1.5v13c-3-1.9-5.7-2.3-8.5-1.5z"/><path d="M20.5 5.2c-2.8-.8-5.4-.4-8.5 1.5v13c3-1.9 5.7-2.3 8.5-1.5z"/></svg>
            <small>@Loc.T("learn")</small>
        </NavLink>
        <NavLink href="/explore">
            <svg class="nav-icon nav-icon-compass" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.7"/><path d="m15.8 8.2-2.2 5.4-5.4 2.2 2.2-5.4z"/></svg>
            <small>@Loc.T("explore")</small>
        </NavLink>
        <NavLink href="/search">
            <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.4"/><path d="m15.6 15.6 4.5 4.5"/></svg>
            <small>@Loc.T("search")</small>
        </NavLink>
        <NavLink href="/saved">
            <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6.2 3.7h11.6v17l-5.8-3.8-5.8 3.8z"/></svg>
            <small>@Loc.T("saved")</small>
        </NavLink>
    </nav>
</div>

@code {
    protected override void OnInitialized() => Loc.Changed += OnLanguageChanged;
    private void ChangeLanguage(string code) => Loc.SetLanguage(code);
    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Loc.Changed -= OnLanguageChanged;
}
